# Credenciais SMTP reais — nunca versionar.
# (mail-config.php em si nao tem segredo, so valores padrao/fallback — e
# versionado de proposito para sobreviver a qualquer redeploy que limpe
# arquivos fora do Git; so o .local.php tem as credenciais reais.)
php/mail-config.local.php

# Credenciais reais do banco de dados do survey — nunca versionar.
# (db-config.php em si nao tem segredo, so valores padrao/fallback — e
# versionado de proposito para sobreviver a qualquer redeploy que limpe
# arquivos fora do Git; so o .local.php tem as credenciais reais.)
php/survey/db-config.local.php

# Credenciais reais do FPV planner — mesmo padrao acima.
php/fpv/config.local.php

# Fotos enviadas pelos usuarios no FPV planner — nunca versionar (conteudo
# gerado em runtime, excluido do deploy via rsync tambem, ver deploy.yml).
img/fpv-uploads/*
!img/fpv-uploads/.gitkeep

# Chave SSH de deploy gerada localmente — nunca versionar (apagar apos configurar)
f91_deploy_key
f91_deploy_key.pub

